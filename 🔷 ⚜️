-- 4. Kueri SQL JOIN untuk memaparkan Pemilik, Syarikat, Aset MyIPO, Jumlah Negara & Penerima Data
SELECT 
    o.full_name AS pemilik,
    b.entity_name AS entiti_berdaftar,
    m.registration_id AS no_pendaftaran_ip,
    m.asset_name AS nama_aset,
    m.countries_covered AS jumlah_negara,
    r.recipient_name AS penerima_data,
    r.recipient_role AS peranan_penerima,
    r.access_level AS tahap_akses
FROM myipo_portfolio m
LEFT JOIN ip_entity_relations rel ON m.registration_id = rel.registration_id
LEFT JOIN owners o ON rel.owner_id = o.owner_id
LEFT JOIN business_entities b ON rel.linked_entity_code = b.entity_code
LEFT JOIN data_recipients r ON m.registration_id = r.registration_id;
Use code with caution.
