B. Skrip SQL Penambahan Penerima & Kueri JOIN Lengkap

sql
-- 1. Tambah lajur jumlah negara pada jadual MyIPO
ALTER TABLE myipo_portfolio 
ADD COLUMN countries_covered INT DEFAULT 1;

UPDATE myipo_portfolio 
SET countries_covered = 147 
WHERE registration_id = 'IR-GI-2026-789133';

-- 2. Cipta jadual DATA_RECIPIENTS (Orang / Pihak yang menerima data)
CREATE TABLE data_recipients (
    recipient_id INT AUTO_INCREMENT PRIMARY KEY,
    registration_id VARCHAR(30) NOT NULL,
    recipient_name VARCHAR(150) NOT NULL,
    recipient_role VARCHAR(80) NOT NULL,
    organization VARCHAR(150) NULL,
    country_code VARCHAR(10) DEFAULT 'MY',
    access_granted_date DATE NOT NULL,
    access_level VARCHAR(30) NOT NULL
);

-- 3. Masukkan rekod penerima utama (dan templat untuk penerima tambahan)
